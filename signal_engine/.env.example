# This is a template for signal_engine's local config, separate from the
# root .env.example (which documents pysgrid-forex's own systemd env file
# on the Oracle server -- a different file, for a different machine).
#
# From the repo root:  cp signal_engine/.env.example .env
# Then edit .env (repo root, NOT this file) with your real values.
# .env is already gitignored -- never commit your real tokens.
#
# Anything you set with $env:X = "..." (PowerShell) or export X=... (bash)
# in your current shell still overrides these -- this file only fills in
# what your shell hasn't already set.

PYSGRID_API_BASE=http://140.245.226.102:8080

# Uncomment to override the default 10-symbol universe:
# SIGNAL_SYMBOLS=XAUUSD,EURUSD,GBPUSD,USDJPY,GBPJPY,AUDUSD,USDCAD,NZDUSD,XAGUSD,USOIL

SIGNAL_POLL_SECONDS=60
SIGNAL_MIN_CONFIDENCE=60

# Telegram alerts -- see docs/SIGNAL_ENGINE.md for how to get these two
# values from @BotFather and getUpdates. Leave blank to disable.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
